[node name="ButtonOutput" type="Control" parent="."]
texture_filter = 1
custom_minimum_size = Vector2(500, 400)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = -199.0
offset_right = 250.0
offset_bottom = 201.0
grow_horizontal = 2
grow_vertical = 2
pivot_offset = Vector2(250, 200)
script = ExtResource("2_dqdkr")
PresetSelection = 99
LabelType = 1
Text = "[p]Initial [b]State[/b] - this is a test of the [u]rich text label[/u] functionality that exists within the omni button. the purpose of this is to show that a large amount of text can be displayed and still utilize the [i]functionality[/i] such as bold, underline, italisis and etc. that is present within the bbcode enabled rich text label. Check it out [color=green]the color green[/color] thats wild another color in the middle of a text block. wow i'm so shocked that this does that soooo seemlessly. very impressive. [/p] please refer to [url]https://docs.godotengine.org/en/latest/tutorials/ui/bbcode_in_richtextlabel.html[/url] for a complete list of bbcode usage in godots documentation.[wave amp=50.0 freq=5.0 connected=1]it can get wavy too thats crazy.[/wave][pulse freq=1.0 color=#ffffff40 ease=-2.0]or if you are feeling it it can do a pulse thats prett cool.[/pulse][tornado radius=10.0 freq=1.0 connected=1]theres also like a tornado looking thing.[/tornado]theres also a [shake rate=20.0 level=5 connected=1]shake[/shake].honestly i'm just trying to fill up the space oooo[fade start=4 length=14] how about a fade[/fade]. that could be fun. always the classic [rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]rainbow [/rainbow]. really the take away here is that there are a lot of functions in bbcode that can really enhance your text output. so if you need it. its here to use as you see fit :).[br][br] p.s. you will have to restart this scene to see this text again"
RichLabelText = "[p]Initial [b]State[/b] - this is a test of the [u]rich text label[/u] functionality that exists within the omni button. the purpose of this is to show that a large amount of text can be displayed and still utilize the [i]functionality[/i] such as bold, underline, italisis and etc. that is present within the bbcode enabled rich text label. Check it out [color=green]the color green[/color] thats wild another color in the middle of a text block. wow i'm so shocked that this does that soooo seemlessly. very impressive. [/p] please refer to [url]https://docs.godotengine.org/en/latest/tutorials/ui/bbcode_in_richtextlabel.html[/url] for a complete list of bbcode usage in godots documentation.[wave amp=50.0 freq=5.0 connected=1]it can get wavy too thats crazy.[/wave][pulse freq=1.0 color=#ffffff40 ease=-2.0]or if you are feeling it it can do a pulse thats prett cool.[/pulse][tornado radius=10.0 freq=1.0 connected=1]theres also like a tornado looking thing.[/tornado]theres also a [shake rate=20.0 level=5 connected=1]shake[/shake].honestly i'm just trying to fill up the space oooo[fade start=4 length=14] how about a fade[/fade]. that could be fun. always the classic [rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]rainbow [/rainbow]. really the take away here is that there are a lot of functions in bbcode that can really enhance your text output. so if you need it. its here to use as you see fit :).[br][br] p.s. you will have to restart this scene to see this text again"
MinFontSize = 12
LabelHorizontalAlignment = 0
LabelAutowrap = 2
TouchSwipeExit = 1
