theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Page" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Page"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "OmniVirtualCursor"

[node name="Subtitle" type="Label" parent="Margin/Page"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.74, 0.82, 1)
theme_override_font_sizes/font_size = 16
text = "A controller cursor for menus. Drop prebuilt/cursor/omni_virtual_cursor.tscn into a menu scene."

[node name="ControllerCards" type="PanelContainer" parent="Margin/Page"]
unique_name_in_owner = true
size_flags_vertical = 3
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("card")

[node name="VBox" type="VBoxContainer" parent="Margin/Page/ControllerCards"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Margin/Page/ControllerCards/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.35, 1)
theme_override_font_sizes/font_size = 17
text = "Try it"

[node name="Desc" type="Label" parent="Margin/Page/ControllerCards/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.76, 0.84, 1)
custom_minimum_size = Vector2(300, 0)
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
text = "Plug in a controller and move the left stick: a ring appears and hovers whatever is under it. A clicks (hold it to hold), the right stick scrolls, and the ring sticks to buttons. The d-pad goes back to normal focus navigation; the mouse hides the ring. The menu is ordinary Controls: OmniButtons, a Godot slider and Godot buttons."

