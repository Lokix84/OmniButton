[node name="OmniDialogDemo" type="Control" unique_id=1191171218]
editor_description = "The OmniButton dialog demo. Run with F6: every button opens a window on demand, and the log shows the call and what it returned.

The Windows button at the top switches between the OmniDialog autoload (code only) and the windows dropped into this scene (ScenePopup, SceneToast, SceneBox, SceneNarration; select one to see its Inspector settings). ShopPopup's question is written in its Inspector. OverlayA and OverlayB show the base overlay with your own content under Root/Panel/Content (click an eye icon to edit one; they always start closed when the game runs).

To make a look: duplicate a .tres in themes/, drag it into this root's Your Look, run, and pick it with the Look button. Save edits in the editor and click back into the game: the look reloads."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_demo")

