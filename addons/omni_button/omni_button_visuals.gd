extends RefCounted
class_name OmniButtonVisuals
## Builds, styles and lays out the generated visuals.
## Static: every function takes the button as its first argument (_o).
##
## Generated visuals. Only the text label is a node; panel, background, icon, selection overlay,
## cooldown fill, hold fill and the joystick thumb are OmniDrawItem canvas items under the _Managed
## root, so hover scaling and ManagedDrawOnTop apply to them exactly as they did to child nodes.
## Draw order is the same z_index ladder the nodes used:
##   panel 0, background 1, icon/thumb 2, label 3, overlay 4, cooldown 5, hold fill 6.

## Node names generated by older versions. Scenes saved with them are cleaned up on rebuild.
const _MANAGED_CHILD_NAMES := {
	"Panel": true,
	"Background": true,
	"Icon": true,
	"Label": true,
	"RichLabel": true,
	"Overlay": true,
	"HoldFill": true,
	"Cooldown": true,
	"DefaultThumb": true,
	"JoystickArea": true
}

const Z_PANEL := 0
const Z_BACKGROUND := 1
const Z_ICON := 2
const Z_LABEL := 3
const Z_OVERLAY := 4
const Z_COOLDOWN := 5
const Z_HOLD_FILL := 6


static func ensure_managed_root(_o: Omni_Button) -> void:
	if _o._managed_root != null and is_instance_valid(_o._managed_root):
		return
	_o._managed_root = Control.new()
	_o._managed_root.name = "_Managed"
	_o.add_child(_o._managed_root)
	ensure_full_rect(_o, _o._managed_root)
	# Generated visuals are decoration: input is routed by the button's own rect, which is exactly
	# what its hit test checks. Oversized icons, labels or hover-scaled visuals must not steal clicks.
	_o._managed_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	position_managed_root(_o)

static func position_managed_root(_o: Omni_Button) -> void:
	if _o._managed_root == null or not is_instance_valid(_o._managed_root):
		return
	var parent := _o
	if _o._managed_draw_on_top:
		parent.move_child(_o._managed_root, parent.get_child_count() - 1)
	else:
		parent.move_child(_o._managed_root, 0)

static func managed_add_child(_o: Omni_Button, node: Node) -> void:
	ensure_managed_root(_o)
	_o._managed_root.add_child(node)

static func ensure_full_rect(_o: Omni_Button, node: Control) -> void:
	if node == null or not is_instance_valid(node):
		return
	node.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	node.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	node.size_flags_vertical = Control.SIZE_EXPAND_FILL

## New canvas item under the _Managed root. Full-rect items get the button size.
static func new_item(_o: Omni_Button, kind: int, item_name: String, z: int, full_rect := true) -> OmniDrawItem:
	ensure_managed_root(_o)
	var item := OmniDrawItem.new(kind, _o._managed_root.get_canvas_item(), item_name, z)
	if full_rect:
		item.size = _o.size
	return item

static func _alive(_o: Omni_Button, item: OmniDrawItem) -> bool:
	return item != null and item.is_alive()

static func _free_item(_o: Omni_Button, item: OmniDrawItem) -> void:
	if item != null:
		item.queue_free()

static func setup_children(_o: Omni_Button) -> void:
	# Scenes saved by older versions (or duplicated in the editor) can carry serialized managed
	# child nodes; purge them by name so exactly one generated set exists.
	var purge_children := func(parent: Node) -> void:
		if parent == null or not is_instance_valid(parent):
			return
		for child in parent.get_children():
			if child is Node and _MANAGED_CHILD_NAMES.has(child.name):
				parent.remove_child(child)
				child.queue_free()
	purge_children.call(_o)
	if _o._managed_root != null and is_instance_valid(_o._managed_root):
		purge_children.call(_o._managed_root)

	# Free only generated visuals; user-added children are untouched.
	for item in [_o._panel, _o._background_tex, _o._icon, _o._overlay, _o._cooldown, _o._hold_fill, _o._default_thumb]:
		_free_item(_o, item)
	for n in [_o._label, _o._rich_label, _o._vj_area_panel]:
		if n != null and is_instance_valid(n):
			var p = n.get_parent()
			if p != null:
				p.remove_child(n)
			n.queue_free()
	_o._panel = null
	_o._background_tex = null
	_o._icon = null
	_o._label = null
	_o._rich_label = null
	_o._overlay = null
	_o._cooldown = null
	_o._hold_fill = null
	_o._default_thumb = null
	_o._vj_area_panel = null

	if _o._background_mode == Omni_Button.BackgroundMode.UsePanel:
		_o._panel = new_item(_o, OmniDrawItem.Kind.STYLE, "Panel", Z_PANEL)
		apply_panel_styling(_o)

	if _o._background_mode == Omni_Button.BackgroundMode.UseTexture and _o.texture != null:
		var bg := new_item(_o, OmniDrawItem.Kind.TEXTURE, "Background", Z_BACKGROUND)
		bg.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		_o._background_tex = bg
		_sync_background(_o)

	if _o._icon_texture != null:
		_create_icon(_o)

	_o._set_label_text()

	# Default thumb for virtual joystick when no icon is provided
	var want_vj := _o._follow_mode == Omni_Button.FollowModeEnum.VirtualJoystick
	var need_default_thumb := want_vj and _o._enable_default_thumb and _o._icon_texture == null
	if need_default_thumb:
		_o._ensure_joystick().ensure_default_thumb()
		_o._ensure_joystick().update_default_thumb_visual()

	update_overlay(_o)

	if _o._cooldown_trigger != _o.CooldownTriggerEnum.None and (_o._cooldown_active or Engine.is_editor_hint()):
		ensure_cooldown(_o)
		OmniButtonTiming.update_cooldown_visual(_o)

static func _create_icon(_o: Omni_Button) -> void:
	var icon := new_item(_o, OmniDrawItem.Kind.TEXTURE, "Icon", Z_ICON)
	icon.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_o._icon = icon
	_sync_icon(_o)

static func _sync_icon(_o: Omni_Button) -> void:
	var icon := _o._icon
	icon.texture = _o._icon_texture
	icon.expand_mode = _o.IconExpandMode
	icon.stretch_mode = _o.IconStretchMode
	icon.flip_h = _o.IconFlipH
	icon.flip_v = _o.IconFlipV
	icon.modulate = _o.IconModulate

static func _sync_background(_o: Omni_Button) -> void:
	var bg := _o._background_tex
	bg.texture = _o.texture
	bg.expand_mode = _o.expand_mode
	bg.stretch_mode = _o.stretch_mode
	bg.flip_h = _o.flip_h
	bg.flip_v = _o.flip_v
	bg.modulate = _o.BackgroundModulate

static func _wants_default_thumb(_o: Omni_Button) -> bool:
	var want_vj := _o._follow_mode == Omni_Button.FollowModeEnum.VirtualJoystick
	return want_vj and _o._enable_default_thumb

## Applies an IconTexture change without rebuilding every generated visual.
## Returns false when a full setup_children(_o) pass is still required (not ready yet, or the
## virtual-joystick default thumb has to be swapped in/out).
static func try_sync_icon_in_place(_o: Omni_Button) -> bool:
	if not _o.is_node_ready():
		return false
	var tex := _o._icon_texture
	var icon_alive := _alive(_o, _o._icon)
	if _wants_default_thumb(_o):
		# Thumb exists exactly when there is no icon; changing that relationship needs a rebuild.
		if (tex == null) != _alive(_o, _o._default_thumb):
			return false
	if tex != null:
		if icon_alive:
			_o._icon.texture = tex
		else:
			_create_icon(_o)
		return true
	if icon_alive:
		_o._icon.queue_free()
		_o._icon = null
	return true

static func update_overlay(_o: Omni_Button) -> void:
	var need := _o._selected
	var alive := _alive(_o, _o._overlay)
	if need and not alive:
		_o._overlay = new_item(_o, OmniDrawItem.Kind.RECT, "Overlay", Z_OVERLAY)
		_o._overlay.color = _o.SelectedColor
		_o._overlay.material = _invert_target(_o)
	elif not need and alive:
		_o._overlay.queue_free()
		_o._overlay = null

static func ensure_cooldown(_o: Omni_Button) -> void:
	if not _alive(_o, _o._cooldown):
		# Above label (3) and selection overlay (4); positioned and sized by the timing module.
		_o._cooldown = new_item(_o, OmniDrawItem.Kind.RECT, "Cooldown", Z_COOLDOWN, false)
		_o._cooldown.color = _o.CooldownColor

static func ensure_hold_fill_rect(_o: Omni_Button) -> void:
	if not _alive(_o, _o._hold_fill):
		_o._hold_fill = new_item(_o, OmniDrawItem.Kind.RECT, "HoldFill", Z_HOLD_FILL, false)
		_o._hold_fill.color = _o.HoldFillColor

static func remove_hold_fill(_o: Omni_Button) -> void:
	if _alive(_o, _o._hold_fill):
		_o._hold_fill.visible = false
		_o._hold_fill.size = Vector2.ZERO
		_o._hold_fill.position = Vector2.ZERO

static func configure_label(_o: Omni_Button, lbl: Label) -> void:
	# Fill parent and zero offsets so it truly stretches
	lbl.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var ep := OmniButtonText.get_effective_label_padding(_o)
	lbl.offset_left = ep.x
	lbl.offset_top = ep.y
	lbl.offset_right = - ep.z
	lbl.offset_bottom = - ep.w
	lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	lbl.size_flags_vertical = Control.SIZE_EXPAND_FILL
	# Respect configured alignment and wrap
	lbl.horizontal_alignment = _o.LabelHorizontalAlignment
	lbl.vertical_alignment = _o.LabelVerticalAlignment
	lbl.autowrap_mode = _o.LabelAutowrap
	lbl.uppercase = _o.LabelUppercase
	lbl.clip_text = _o.LabelClipText
	lbl.text_overrun_behavior = _o.LabelTextOverrun
	# Apply optional font override
	if _o.LabelFont != null:
		lbl.add_theme_font_override("font", _o.LabelFont)
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	lbl.visible_characters_behavior = TextServer.VC_CHARS_AFTER_SHAPING

static func configure_rich_label(_o: Omni_Button, rtl: RichTextLabel) -> void:
	rtl.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var ep := OmniButtonText.get_effective_label_padding(_o)
	rtl.offset_left = ep.x
	rtl.offset_top = ep.y
	rtl.offset_right = - ep.z
	rtl.offset_bottom = - ep.w
	rtl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rtl.size_flags_vertical = Control.SIZE_EXPAND_FILL
	rtl.bbcode_enabled = _o.RichLabelUseBBCode
	rtl.scroll_active = _o.RichTextScrollActive
	rtl.scroll_following = _o.RichTextScrollFollowing
	rtl.selection_enabled = _o.RichTextSelectionEnabled
	rtl.context_menu_enabled = _o.RichTextContextMenuEnabled
	rtl.fit_content = _o.RichTextFitContent
	rtl.autowrap_mode = _o.LabelAutowrap
	rtl.horizontal_alignment = _o.LabelHorizontalAlignment
	rtl.vertical_alignment = _o.LabelVerticalAlignment
	if _o.LabelFont != null:
		rtl.add_theme_font_override("normal_font", _o.LabelFont)
	rtl.add_theme_color_override("default_color", _o.LabelTextColor)
	# Rich text only needs the mouse for its own selection/scrolling; otherwise it is decoration.
	rtl.mouse_filter = Control.MOUSE_FILTER_PASS if (_o.RichTextSelectionEnabled or _o.RichTextScrollActive) else Control.MOUSE_FILTER_IGNORE
	rtl.visible_characters_behavior = TextServer.VC_CHARS_AFTER_SHAPING

## Full-rect visuals follow the button size (the nodes did this through their anchors).
static func layout_content(_o: Omni_Button) -> void:
	var s := _o.size
	for item in [_o._panel, _o._background_tex, _o._icon, _o._overlay]:
		if _alive(_o, item):
			item.size = s

static func apply_visual_state(_o: Omni_Button) -> void:
	if _o._background_mode == Omni_Button.BackgroundMode.UsePanel and not _alive(_o, _o._panel):
		_o._panel = new_item(_o, OmniDrawItem.Kind.STYLE, "Panel", Z_PANEL)
	update_overlay(_o)
	layout_content(_o)
	var mat := _invert_target(_o)

	if _o._background_mode == Omni_Button.BackgroundMode.UsePanel and _alive(_o, _o._panel):
		_o._panel.visible = true
		_o._panel.modulate = _o.PanelModulate
		_o._panel.material = mat

	if _o._background_mode == Omni_Button.BackgroundMode.UseTexture and _alive(_o, _o._background_tex):
		_sync_background(_o)
		_o._background_tex.material = mat

	if _alive(_o, _o._icon):
		_sync_icon(_o)
		_o._icon.material = mat

	if _o._label != null:
		if not _o._tw_active:
			_o._label.text = _o._text
		configure_label(_o, _o._label)
		_o._label.add_theme_color_override("font_color", _o.LabelTextColor)
		_o._label.modulate = _o.TextModulate
		_set_node_material(_o, _o._label, mat)
		_o._label.z_index = Z_LABEL
	if _o._rich_label != null:
		if not _o._tw_active:
			_o._rich_label.text = _o._text
		configure_rich_label(_o, _o._rich_label)
		_o._rich_label.add_theme_color_override("default_color", _o.LabelTextColor)
		_o._rich_label.modulate = _o.TextModulate
		_set_node_material(_o, _o._rich_label, mat)
		_o._rich_label.z_index = Z_LABEL

	if _alive(_o, _o._overlay):
		_o._overlay.visible = _o._selected
		_o._overlay.color = _o.SelectedColor
		_o._overlay.material = mat

	if _alive(_o, _o._cooldown):
		_o._cooldown.color = _o.CooldownColor
	if _alive(_o, _o._hold_fill):
		_o._hold_fill.color = _o.HoldFillColor
	apply_panel_styling(_o)

## Material every generated visual should currently carry: the invert shader or null.
static func _invert_target(_o: Omni_Button) -> Material:
	if _o._invert_material == null:
		return null
	var modes := _o.InvertModes
	var hold_duration := _o._hold_duration
	var hold_active := _o._is_holding or (hold_duration > 0.0 and _o._is_pressed and _o._hold_timer >= hold_duration)
	var cooldown_active := _o._cooldown_active and _o.InvertOnCooldown and (_o.CooldownInvertDuration <= 0.0 or _o._cooldown_elapsed <= _o.CooldownInvertDuration)
	var should := (_o._is_pressed and (modes & _o.INVERT_PRESS) != 0) \
		or (_o._is_toggled and (modes & _o.INVERT_TOGGLE) != 0) \
		or (_o._is_hovering and (modes & _o.INVERT_HOVER) != 0) \
		or (hold_active and (modes & _o.INVERT_HOLD) != 0) \
		or cooldown_active
	return _o._invert_material if should else null

## CanvasItem.set_material() does not early-out on an identical value, so compare first.
## (OmniDrawItem.material already does this itself.)
static func _set_node_material(_o: Omni_Button, node: CanvasItem, mat: Material) -> void:
	if node != null and is_instance_valid(node) and node.material != mat:
		node.material = mat

## Cheap pass for interaction-state changes: material, overlay visibility and panel style only.
static func apply_state_visuals(_o: Omni_Button) -> void:
	var mat := _invert_target(_o)
	if _o._panel != null: _o._panel.material = mat
	if _o._background_tex != null: _o._background_tex.material = mat
	if _o._icon != null: _o._icon.material = mat
	_set_node_material(_o, _o._label, mat)
	_set_node_material(_o, _o._rich_label, mat)
	if _alive(_o, _o._overlay):
		_o._overlay.visible = _o._selected
		_o._overlay.material = mat
	refresh_panel_style(_o)

## Point the panel at the style for the current state; the item redraws only if it changed.
static func refresh_panel_style(_o: Omni_Button) -> void:
	if _o._background_mode != Omni_Button.BackgroundMode.UsePanel or not _alive(_o, _o._panel):
		return
	_o._panel.style = _resolved_panel_style(_o)

## What a Panel node would draw: the state override, else the theme's "panel" stylebox for
## PanelThemeVariation (falling back to the Panel type like a node's own class does).
static func _resolved_panel_style(_o: Omni_Button) -> StyleBox:
	var style := _active_panel_style(_o)
	if style != null:
		return style
	var variation := StringName(_o.PanelThemeVariation)
	if variation != &"" and _o.has_theme_stylebox(&"panel", variation):
		return _o.get_theme_stylebox(&"panel", variation)
	return _o.get_theme_stylebox(&"panel", &"Panel")

static func apply_panel_styling(_o: Omni_Button) -> void:
	if _o._background_mode != Omni_Button.BackgroundMode.UsePanel:
		return
	if not _alive(_o, _o._panel):
		return
	refresh_panel_style(_o)
	if Engine.is_editor_hint():
		_o.queue_redraw()

static func _active_panel_style(_o: Omni_Button) -> StyleBox:
	if _o._disabled and _o.PanelDisabledStyleBox != null:
		return _o.PanelDisabledStyleBox
	if (_o._is_pressed or _o._is_toggled) and _o.PanelPressedStyleBox != null:
		return _o.PanelPressedStyleBox
	if _o._is_hovering and _o.PanelHoverStyleBox != null:
		return _o.PanelHoverStyleBox
	if _o.has_focus() and _o.PanelFocusStyleBox != null:
		return _o.PanelFocusStyleBox
	return _o.PanelStyleBox
